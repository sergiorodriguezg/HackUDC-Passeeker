{
  "name": "Passeeker",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Autofill y guardado de credenciales conectado a Passeeker Desktop.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}